# Copy this file to .env and replace placeholders with your own credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=CyberEvidentRAG

GEMINI_API_KEY=your_gemini_api_key
GEMINI_GENERATION_MODEL=gemini-flash-lite-latest
OPENROUTER_API_KEY=your_openrouter_api_key

KNOWLEDGE_COLLECTION=knowledge_chunks
CONVERSATIONS_COLLECTION=conversations
MAX_CONVERSATION_TURNS=6
RAG_TOP_K=5
RETRIEVAL_CANDIDATE_LIMIT=100

BM25_K1=1.5
BM25_B=0.75
BM25_IDENTIFIER_BOOST=8.0
BM25_TITLE_PREFIX_BOOST=14.0
BM25_TITLE_PHRASE_BOOST=4.0
BM25_TECHNIQUE_OVER_TACTIC_BOOST=5.0
BM25_SCORE_SATURATION=6.0
EVIDENCE_MIN_LOCAL_RELEVANCE=0.12
EVIDENCE_MIN_QUERY_COVERAGE=0.30
PROMPT_CONTEXT_MAX_CHARS=12000
CITATION_MIN_TOKEN_OVERLAP=0.30
